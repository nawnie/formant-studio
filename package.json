{
  "name": "formant-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local, AI-connectable Web Audio groove workstation for Windows and macOS.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node server/http.mjs --dev",
    "build": "tsc -b && vite build",
    "start": "node server/http.mjs",
    "launch": "node scripts/launch.mjs",
    "stop": "node scripts/stop.mjs",
    "mcp": "node server/mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:mcp": "node scripts/verify-mcp.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
